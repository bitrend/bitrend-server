    "schemas": {
      "AuthResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT 인증 토큰"
          },
          "user": {
            "$ref": "#/components/schemas/UserProfile"
          }
        },
        "required": ["token", "user"]
      },
      "Repository": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "full_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "private": {
            "type": "boolean"
          },
          "html_url": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "stargazers_count": {
            "type": "integer"
          },
          "forks_count": {
            "type": "integer"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RepositoryDetail": {
        "allOf": [
          {"$ref": "#/components/schemas/Repository"},
          {
            "type": "object",
            "properties": {
              "size": {
                "type": "integer"
              },
              "default_branch": {
                "type": "string"
              },
              "topics": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "license": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        ]
      },
      "EvaluationProject": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "repositoryUrl": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "analyzing", "completed", "failed"]
          },
          "order": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "name", "repositoryUrl", "status"]
      },
      "CreateEvaluationProject": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "repositoryUrl": {
            "type": "string"
          }
        },
        "required": ["name", "repositoryUrl"]
      },
      "ReorderProjectsRequest": {
        "type": "object",
        "properties": {
          "projectIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "새로운 순서로 정렬된 프로젝트 ID 배열"
          }
        },
        "required": ["projectIds"]
      },
      "StartAnalysisRequest": {
        "type": "object",
        "properties": {
          "projectIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "includeAI": {
            "type": "boolean",
            "default": false,
            "description": "AI 분석 포함 여부"
          }
        },
        "required": ["projectIds"]
      },
      "AnalysisStartResponse": {
        "type": "object",
        "properties": {
          "analysisId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["started", "queued"]
          },
          "estimatedCompletion": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AnalysisStatus": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "running", "completed", "failed"]
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "currentStep": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "AnalysisResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "projectResults": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectAnalysisResult"
            }
          },
          "summary": {
            "type": "object",
            "properties": {
              "totalProjects": {
                "type": "integer"
              },
              "averageScore": {
                "type": "number"
              },
              "recommendations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProjectAnalysisResult": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string"
          },
          "projectName": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "metrics": {
            "type": "object",
            "properties": {
              "codeQuality": {
                "type": "number"
              },
              "performance": {
                "type": "number"
              },
              "security": {
                "type": "number"
              },
              "maintainability": {
                "type": "number"
              }
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "severity": {
                  "type": "string",
                  "enum": ["low", "medium", "high", "critical"]
                },
                "message": {
                  "type": "string"
                },
                "file": {
                  "type": "string"
                },
                "line": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "Recommendation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["learning", "tool", "library", "best_practice"]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "category": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "estimatedTime": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "LearningPath": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "estimatedDuration": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "order": {
                  "type": "integer"
                },
                "estimatedTime": {
                  "type": "string"
                },
                "resources": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Recommendation"
                  }
                }
              }
            }
          },
          "progress": {
            "type": "object",
            "properties": {
              "completedSteps": {
                "type": "integer"
              },
              "totalSteps": {
                "type": "integer"
              },
              "percentage": {
                "type": "number"
              }
            }
          }
        }
      },
      "DetailedHealth": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "uptime": {
            "type": "number"
          },
          "database": {
            "type": "object",
            "properties": {
              "connected": {
                "type": "boolean"
              },
              "responseTime": {
                "type": "number"
              }
            }
          },
          "memory": {
            "type": "object",
            "properties": {
              "used": {
                "type": "number"
              },
              "total": {
                "type": "number"
              },
              "percentage": {
                "type": "number"
              }
            }
          }
        }
      },
      "Metrics": {
        "type": "object",
        "properties": {
          "requestCount": {
            "type": "integer"
          },
          "averageResponseTime": {
            "type": "number"
          },
          "errorRate": {
            "type": "number"
          },
          "activeConnections": {
            "type": "integer"
          },
          "systemLoad": {
            "type": "object",
            "properties": {
              "cpu": {
                "type": "number"
              },
              "memory": {
                "type": "number"
              }
            }
          }
        }
      },
      "UserProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "githubId": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "joinDate": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "id",
          "githubId",
          "username",
          "name",
          "avatarUrl",
          "role",
          "joinDate"
        ]
      },
      "CreateUserRequest": {
        "type": "object",
        "properties": {
          "githubId": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "default": "user"
          }
        },
        "required": ["githubId", "username", "name"]
      },
      "UserStats": {
        "type": "object",
        "properties": {
          "totalProjects": {
            "type": "integer"
          },
          "completedProjects": {
            "type": "integer"
          },
          "inProgressProjects": {
            "type": "integer"
          },
          "totalContributions": {
            "type": "integer"
          }
        },
        "required": [
          "totalProjects",
          "completedProjects",
          "inProgressProjects",
          "totalContributions"
        ]
      },
      "UserActivity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "type": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "projectName": {
            "type": [
              "string",
              "null"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "relativeTime": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "action",
          "timestamp",
          "relativeTime"
        ]
      },
      "UserActivitiesResponse": {
        "type": "object",
        "properties": {
          "activities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserActivity"
            }
          },
          "total": {
            "type": "integer"
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "required": [
          "activities",
          "total",
          "hasMore"
        ]
      },
      "UpdateUserProfileRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "Image": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}