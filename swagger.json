{
  "openapi": "3.0.0",
  "info": {
    "title": "Bitrend API",
    "version": "1.0.0",
    "description": "Bitrend 서버 API - GitHub 기반 개발자 트렌드 분석 플랫폼"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "로컬 개발 서버"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health Check"],
        "summary": "서버 상태 확인",
        "responses": {
          "200": {
            "description": "서버가 정상 동작 중",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/github/callback": {
      "post": {
        "tags": ["Authentication"],
        "summary": "GitHub OAuth 콜백 처리",
        "description": "GitHub OAuth 인증 코드를 받아 JWT 토큰과 사용자 정보를 반환합니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "authorizationCode": {
                    "type": "string",
                    "description": "GitHub OAuth 인증 코드"
                  }
                },
                "required": ["authorizationCode"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "인증 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "잘못된 요청"
          },
          "500": {
            "description": "서버 에러"
          }
        }
      }
    },
    "/api/github/repositories": {
      "get": {
        "tags": ["GitHub"],
        "summary": "사용자의 GitHub 저장소 목록 조회",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {
            "description": "저장소 목록",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Repository"
                  }
                }
              }
            }
          },
          "401": {
            "description": "인증되지 않음"
          }
        }
      }
    },
    "/api/github/repositories/{owner}/{repo}": {
      "get": {
        "tags": ["GitHub"],
        "summary": "특정 저장소의 상세 정보 조회",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "저장소 소유자"
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "저장소 이름"
          }
        ],
        "responses": {
          "200": {
            "description": "저장소 상세 정보",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepositoryDetail"
                }
              }
            }
          },
          "401": {
            "description": "인증되지 않음"
          },
          "404": {
            "description": "저장소를 찾을 수 없음"
          }
        }
      }
    },
    "/api/evaluation/projects": {
      "get": {
        "tags": ["Evaluation"],
        "summary": "평가 프로젝트 목록 조회",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {
