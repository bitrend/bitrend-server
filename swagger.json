                    "$ref": "#/components/schemas/EvaluationProject"
                  }
                }
              }
            }
          },
          "401": {
            "description": "인증되지 않음"
          }
        }
      },
      "post": {
        "tags": ["Evaluation"],
        "summary": "새로운 평가 프로젝트 추가",
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEvaluationProject"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "프로젝트 생성됨",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationProject"
                }
              }
            }
          },
          "400": {
            "description": "잘못된 요청"
          },
          "401": {
            "description": "인증되지 않음"
          }
        }
      }
    },
    "/api/evaluation/projects/reorder": {
      "put": {
        "tags": ["Evaluation"],
        "summary": "평가 프로젝트 순서 변경",
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReorderProjectsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "순서 변경 완료"
          },
          "400": {
            "description": "잘못된 요청"
          },
          "401": {
            "description": "인증되지 않음"
          }
        }
      }
    },
    "/api/evaluation/projects/{id}": {
      "get": {
        "tags": ["Evaluation"],
        "summary": "특정 평가 프로젝트 조회",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "프로젝트 정보",
