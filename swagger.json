      "delete": {
        "tags": ["Evaluation"],
        "summary": "평가 프로젝트 삭제",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "삭제 완료"
          },
          "401": {
            "description": "인증되지 않음"
          },
          "404": {
            "description": "프로젝트를 찾을 수 없음"
          }
        }
      }
    },
    "/api/analysis/evaluation": {
      "post": {
